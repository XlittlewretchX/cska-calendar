{
  "name": "cska-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automatically updated calendar of PFC CSKA first-team matches",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "update": "tsx src/index.ts",
    "bootstrap": "tsx src/index.ts --bootstrap",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "devalue": "^6.0.2",
    "ical-generator": "^9.0.0",
    "luxon": "^3.7.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.12",
    "eslint": "^10.12.0",
    "ical.js": "^2.2.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^5.0.4"
  }
}
